# GEMINI_API_KEY: Required for server-side Gemini AI PDF schedule analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for Eku AI assistant (OpenAI Responses API, server-side only).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Learning Resource Search APIs (server-side only — never expose with VITE_ prefix)
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""
YOUTUBE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Authentication (Client-side public keys only — NEVER add service_role keys here)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
