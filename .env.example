# GEMINI_API_KEY: Required for unified server-side Ekagra AI Brain (free tier).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_LITE_MODEL="gemini-3.1-flash-lite"

# Optional Free Learning Resource Search APIs (server-side only — never expose with VITE_ prefix)
# When unset, Ekagra uses Gemini Search Grounding at ₹0 cost.
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""
YOUTUBE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Authentication (Client-side public keys only — NEVER add service_role keys here)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
